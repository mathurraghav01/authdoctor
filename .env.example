# ---------------------------------------------------------------------------
# AuthDoctor server configuration
# Copy to .env (never commit .env) or set these in your hosting provider.
# ---------------------------------------------------------------------------

PORT=8787
NODE_ENV=development

# Comma-separated list of allowed browser origins. The Vite dev server proxies
# /api, so local development works with the default.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Open model inference (OpenAI-compatible Chat Completions API)
# ---------------------------------------------------------------------------
# AuthDoctor speaks the standard OpenAI-compatible protocol, so any open-model
# host works: the OpenFire credit endpoint, OpenRouter, Groq, Together, vLLM,
# Ollama (http://localhost:11434/v1) and so on.
#
# Leave these empty to run AuthDoctor in Local mode: the deterministic rule
# engine still diagnoses requests, and the assistant uses its local intent
# router. The UI states clearly which mode is active.
#
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_TIMEOUT_MS=45000
# AI_MAX_TOKENS=1600
